# Touwaka Mate - 环境变量配置示例
# 复制此文件为 .env 并填入实际值

# 数据库配置（必填）
DB_HOST=localhost
DB_PORT=3306
DB_NAME=touwaka_mate
DB_USER=your_db_user
DB_PASSWORD=your_db_password

# 服务器配置
API_PORT=3017

# 数据目录配置
DATA_BASE_PATH=./data
WORKSPACE_ROOT=./data/work
KB_IMAGES_ROOT=./data/kb-images

# JWT 配置（生产环境必填！建议使用 32 位以上随机字符串）
JWT_SECRET=your-secret-key-change-in-production
JWT_REFRESH_SECRET=your-refresh-secret-key

# Python 可执行文件路径
PYTHON_PATH=python3

# 日志级别：debug, info, warn, error
LOG_LEVEL=info

# erix 上下文折叠策略（issue #1277）。三档都是引擎内置策略名，大小写敏感：
#   fold-llm          语义摘要折叠（默认）——每次真折叠多一次模型调用；摘要器坏则本次请求 failed
#   fold-statistical  统计式摘要折叠，零 LLM
#   sliding-window    机械折叠（整轮 tail keep / head drop），零 LLM
# 未设/留空 = fold-llm。非法值会在装配处直接报错（不会静默退回默认档）。
# 摘要器故障时的「一键回退」口，不需要发版：
# ERIX_FOLDING_STRATEGY=fold-statistical
