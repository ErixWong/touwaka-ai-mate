{
  "id": "invoice-mgr",
  "name": "发票管理",
  "version": "1.1.0",
  "description": "上传发票文件，AI自动识别并结构化提取发票信息。PDF使用fapiao技能，图片使用多模态VL模型直接识别。自动去重入库",
  "icon": "🧾",
  "type": "document",
  "author": "Touwaka Team",
  "license": "MIT",
  "keywords": [
    "发票",
    "invoice",
    "AI识别",
    "fapiao",
    "VLM"
  ],
  "compatibility": {
    "min_platform_version": "2.0.0",
    "requires": {
      "skills": [
        "fapiao",
        "pdf"
      ]
    }
  },
  "fields": [
    {
      "name": "invoice_file",
      "label": "发票文件",
      "type": "file",
      "accept": ".pdf,.jpg,.jpeg,.png"
    }
  ],
  "extension_tables": [
    {
      "name": "app_invoice_mgr_rows",
      "type": "primary",
      "fields": [
        {
          "name": "user_id",
          "type": "VARCHAR(32)",
          "label": "用户ID（系统内部字段）",
          "source": "user_id"
        },
        {
          "name": "invoice_number",
          "type": "VARCHAR(20)",
          "label": "发票号码",
          "source": "invoice_number"
        },
        {
          "name": "invoice_date",
          "type": "DATE",
          "label": "开票日期",
          "source": "invoice_date"
        },
        {
          "name": "invoice_type",
          "type": "VARCHAR(64)",
          "label": "发票类型",
          "source": "invoice_type"
        },
        {
          "name": "seller_name",
          "type": "VARCHAR(128)",
          "label": "销售方",
          "source": "seller_name"
        },
        {
          "name": "seller_tax_id",
          "type": "VARCHAR(20)",
          "label": "销售方税号",
          "source": "seller_tax_id"
        },
        {
          "name": "buyer_name",
          "type": "VARCHAR(128)",
          "label": "购买方",
          "source": "buyer_name"
        },
        {
          "name": "buyer_tax_id",
          "type": "VARCHAR(20)",
          "label": "购买方税号",
          "source": "buyer_tax_id"
        },
        {
          "name": "total_amount",
          "type": "DECIMAL(12,2)",
          "label": "合计金额",
          "source": "total_amount"
        },
        {
          "name": "total_tax",
          "type": "DECIMAL(12,2)",
          "label": "税额",
          "source": "total_tax"
        },
        {
          "name": "total_with_tax",
          "type": "DECIMAL(12,2)",
          "label": "价税合计",
          "source": "total_with_tax"
        },
        {
          "name": "item_count",
          "type": "INT",
          "label": "商品项数",
          "source": "item_count"
        },
        {
          "name": "page_count",
          "type": "INT",
          "label": "PDF页数",
          "source": "page_count"
        },
        {
          "name": "remarks",
          "type": "TEXT",
          "label": "备注",
          "source": "remarks"
        },
        {
          "name": "issuer",
          "type": "VARCHAR(32)",
          "label": "开票人",
          "source": "issuer"
        },
        {
          "name": "ocr_method",
          "type": "VARCHAR(32)",
          "label": "识别方法",
          "source": "ocr_method"
        },
        {
          "name": "extraction_status",
          "type": "VARCHAR(16)",
          "label": "提取状态",
          "source": "extraction_status"
        },
        {
          "name": "text_items_count",
          "type": "INT",
          "label": "文本项数",
          "source": "text_items_count"
        },
        {
          "name": "keyword_count",
          "type": "INT",
          "label": "关键词数",
          "source": "keyword_count"
        }
      ],
      "indexes": [
        "invoice_number",
        "seller_name",
        "buyer_name",
        "invoice_date",
        "total_with_tax"
      ]
    },
    {
      "name": "app_invoice_mgr_items",
      "type": "detail",
      "fields": [
        {
          "name": "id",
          "type": "VARCHAR(32)",
          "label": "ID",
          "source": "id"
        },
        {
          "name": "page_number",
          "type": "INT",
          "label": "页码"
        },
        {
          "name": "sort_order",
          "type": "INT",
          "label": "序号"
        },
        {
          "name": "category",
          "type": "VARCHAR(64)",
          "label": "分类"
        },
        {
          "name": "name",
          "type": "VARCHAR(128)",
          "label": "商品名称"
        },
        {
          "name": "model",
          "type": "VARCHAR(64)",
          "label": "规格型号"
        },
        {
          "name": "unit",
          "type": "VARCHAR(16)",
          "label": "单位"
        },
        {
          "name": "quantity",
          "type": "DECIMAL(12,4)",
          "label": "数量"
        },
        {
          "name": "price",
          "type": "DECIMAL(12,4)",
          "label": "单价"
        },
        {
          "name": "amount",
          "type": "DECIMAL(12,2)",
          "label": "金额"
        },
        {
          "name": "tax_rate",
          "type": "VARCHAR(8)",
          "label": "税率"
        },
        {
          "name": "tax_amount",
          "type": "DECIMAL(12,2)",
          "label": "税额"
        }
      ]
    }
  ],
  "migrations": {
    "install": "migrations/install.js",
    "uninstall": "migrations/uninstall.js"
  },
  "config": {
    "features": [
      "upload",
      "list",
      "detail"
    ],
    "supported_formats": [
      ".pdf",
      ".jpg",
      ".jpeg",
      ".png"
    ],
    "max_file_size": 20971520,
    "batch_enabled": true,
    "batch_limit": 20,
    "step_resources": {
      "pending_extract": {
        "type": "internal_llm",
        "model_type": "text",
        "llm": {
          "prompt_type": "extract_invoice_from_ocr",
          "temperature": 0.1
        }
      },
      "pending_vl_extract": {
        "type": "internal_llm",
        "model_type": "multimodal",
        "llm": {
          "model_id": null,
          "temperature": 0.1,
          "timeout_ms": 120000
        }
      }
    }
  },
  "states": [
    {
      "name": "pending_process",
      "label": "待处理",
      "description": "PDF走fapiao技能，图片直通多模态VL视觉提取",
      "sort_order": 1,
      "is_initial": true,
      "is_terminal": false,
      "is_error": false
    },
    {
      "name": "pending_vl_extract",
      "label": "VL视觉提取",
      "description": "调用多模态Vision-Language模型直接识别发票图片",
      "sort_order": 2,
      "is_initial": false,
      "is_terminal": false,
      "is_error": false
    },
    {
      "name": "pending_review",
      "label": "待确认",
      "sort_order": 3,
      "is_initial": false,
      "is_terminal": false,
      "is_error": false
    },
    {
      "name": "confirmed",
      "label": "已确认",
      "sort_order": 4,
      "is_initial": false,
      "is_terminal": true,
      "is_error": false
    },
    {
      "name": "extract_failed",
      "label": "识别失败",
      "sort_order": 98,
      "is_initial": false,
      "is_terminal": false,
      "is_error": true
    }
  ],
  "runtime": {
    "frontend": {
      "entry": "frontend/views/AppRuntimeView.vue"
    },
    "tick": "tick/index.js"
  },
  "views": {
    "list": {
      "columns": [
        "invoice_number",
        "invoice_date",
        "seller_name",
        "buyer_name",
        "total_with_tax"
      ],
      "sort": {
        "field": "invoice_date",
        "order": "desc"
      }
    }
  },
  "visibility": "all"
}
