{
  "id": "contract-mgr",
  "name": "销售合同管理",
  "version": "1.0.0",
  "description": "上传合同文件，AI自动提取合同元数据，支持批量处理和确认入库",
  "icon": "📄",
  "type": "document",
  "author": "Touwaka Team",
  "license": "MIT",
  "repository": "https://github.com/ErixWong/touwaka-ai-mate/tree/main/apps/contract-manager",
  "keywords": [
    "合同",
    "文档",
    "OCR",
    "AI提取"
  ],
  "compatibility": {
    "min_platform_version": "2.0.0",
    "requires": {
      "mcp": [
        "markitdown",
        "mineru"
      ],
      "skills": []
    }
  },
  "fields": [
    {
      "name": "party_b",
      "label": "乙方",
      "type": "text",
      "required": true,
      "ai_extractable": true
    },
    {
      "name": "payment_terms",
      "label": "付款条款",
      "type": "textarea",
      "ai_extractable": true
    },
    {
      "name": "start_date",
      "label": "开始日期",
      "type": "date",
      "ai_extractable": true
    },
    {
      "name": "end_date",
      "label": "结束日期",
      "type": "date",
      "ai_extractable": true
    },
    {
      "name": "contract_file",
      "label": "合同文件",
      "type": "file"
    }
  ],
  "extension_tables": [
    {
      "name": "app_contract_mgr_rows",
      "type": "primary",
      "fields": [
        {
          "name": "contract_number",
          "type": "VARCHAR(64)",
          "label": "合同编号",
          "required": true,
          "source": "contract_number"
        },
        {
          "name": "party_a",
          "type": "VARCHAR(128)",
          "label": "甲方",
          "required": true,
          "source": "party_a"
        },
        {
          "name": "party_b",
          "type": "VARCHAR(128)",
          "label": "乙方",
          "required": true,
          "source": "party_b"
        },
        {
          "name": "parent_company",
          "type": "VARCHAR(128)",
          "label": "上级公司",
          "source": "parent_company"
        },
        {
          "name": "contract_amount",
          "type": "DECIMAL(15,2)",
          "label": "合同金额",
          "required": true,
          "source": "contract_amount"
        },
        {
          "name": "contract_date",
          "type": "DATE",
          "label": "签订日期",
          "required": true,
          "source": "contract_date"
        }
      ],
      "indexes": [
        "contract_number",
        "party_a",
        "party_b",
        "parent_company",
        "contract_amount",
        "contract_date"
      ]
    },
    {
      "name": "app_contract_mgr_content",
      "type": "content",
      "fields": [
        {
          "name": "process_step",
          "type": "VARCHAR(32)",
          "label": "处理步骤"
        },
        {
          "name": "file_id",
          "type": "VARCHAR(32)",
          "label": "文件ID"
        },
        {
          "name": "ocr_task_id",
          "type": "VARCHAR(128)",
          "label": "OCR任务ID"
        },
        {
          "name": "ocr_text",
          "type": "LONGTEXT"
        },
        {
          "name": "ocr_service",
          "type": "VARCHAR(64)"
        },
        {
          "name": "ocr_at",
          "type": "DATETIME"
        },
        {
          "name": "filtered_text",
          "type": "LONGTEXT"
        },
        {
          "name": "filter_at",
          "type": "DATETIME"
        },
        {
          "name": "sections",
          "type": "JSON"
        },
        {
          "name": "extract_prompt",
          "type": "TEXT"
        },
        {
          "name": "extract_json",
          "type": "LONGTEXT"
        },
        {
          "name": "extract_model",
          "type": "VARCHAR(64)"
        },
        {
          "name": "extract_temperature",
          "type": "DECIMAL(3,2)"
        },
        {
          "name": "extract_at",
          "type": "DATETIME"
        }
      ]
    },
    {
      "name": "app_contract_mgr_compares",
      "type": "compare",
      "fields": [
        {
          "name": "target_row_id",
          "type": "VARCHAR(32)",
          "label": "对比合同ID",
          "required": true
        },
        {
          "name": "compare_result",
          "type": "JSON",
          "label": "比对结果"
        },
        {
          "name": "summary_identical",
          "type": "INT",
          "label": "一致"
        },
        {
          "name": "summary_modified",
          "type": "INT",
          "label": "修改"
        },
        {
          "name": "summary_added",
          "type": "INT",
          "label": "新增"
        },
        {
          "name": "summary_removed",
          "type": "INT",
          "label": "删除"
        },
        {
          "name": "model_name",
          "type": "VARCHAR(64)",
          "label": "模型"
        },
        {
          "name": "duration_ms",
          "type": "INT",
          "label": "耗时(ms)"
        }
      ],
      "indexes": [
        "target_row_id",
        "summary_modified"
      ]
    }
  ],
  "migrations": {
    "install": "migrations/install.js",
    "uninstall": "migrations/uninstall.js",
    "register_clock": "migrations/20250520_register_clock.js"
  },
  "views": {
    "list": {
      "columns": [
        "contract_number",
        "contract_date",
        "party_a",
        "party_b",
        "contract_amount"
      ],
      "sort": {
        "field": "contract_date",
        "order": "desc"
      }
    }
  },
  "config": {
    "features": [
      "upload",
      "list",
      "detail"
    ],
    "supported_formats": [
      ".pdf",
      ".docx",
      ".doc",
      ".jpg",
      ".png"
    ],
    "max_file_size": 20971520,
    "batch_enabled": true,
    "batch_limit": 50,
    "step_resources": {
      "pending_ocr": {
        "type": "mcp",
        "mcp": {
          "server": "markitdown",
          "tool": "create_task",
          "params_mapping": {
            "file_base64": "file.base64",
            "file_name": "file.name"
          }
        },
        "timeout_ms": 1200000
      },
      "ocr_processing": {
        "type": "mcp",
        "mcp": {
          "server": "markitdown",
          "tool": "get_task_status",
          "hide_params_mapping": true
        },
        "judge_model_id": null,
        "judge_temperature": 0.1,
        "timeout_ms": 600000
      },
      "pending_clean": {
        "type": "internal_llm",
        "model_id": null,
        "temperature": 0.3,
        "timeout_ms": 600000
      },
      "cleaning": {
        "type": "internal_llm",
        "model_id": null,
        "temperature": 0.3,
        "timeout_ms": 600000
      },
      "pending_extract": {
        "type": "internal_llm",
        "model_id": null,
        "temperature": 0.3,
        "timeout_ms": 600000
      },
      "extract_processing": {
        "type": "internal_llm",
        "model_id": null,
        "temperature": 0.3,
        "timeout_ms": 600000
      },
      "pending_section": {
        "type": "internal_llm",
        "model_id": null,
        "temperature": 0.3,
        "timeout_ms": 600000
      },
      "section_processing": {
        "type": "internal_llm",
        "model_id": null,
        "temperature": 0.3,
        "timeout_ms": 600000
      }
    }
  },
  "states": [
    {
      "name": "pending_ocr",
      "label": "等待OCR",
      "description": "等待启动OCR任务",
      "sort_order": 1,
      "is_initial": true,
      "is_terminal": false,
      "is_error": false,
      "handler": null,
      "success_next": "ocr_processing",
      "failure_next": "ocr_failed"
    },
    {
      "name": "ocr_processing",
      "label": "OCR处理中",
      "description": "OCR任务已提交，正在等待OCR服务返回结果",
      "sort_order": 2,
      "is_initial": false,
      "is_terminal": false,
      "is_error": false,
      "handler": null,
      "success_next": "pending_clean",
      "failure_next": "ocr_failed",
      "is_processing": true
    },
    {
      "name": "pending_clean",
      "label": "等待清洗",
      "description": "等待启动文本清洗",
      "sort_order": 3,
      "is_initial": false,
      "is_terminal": false,
      "is_error": false,
      "handler": null,
      "success_next": "cleaning",
      "failure_next": "clean_failed"
    },
    {
      "name": "cleaning",
      "label": "文本清洗中",
      "description": "文本清洗进行中，清理OCR结果中的无关内容（页码、水印、乱码等）",
      "sort_order": 4,
      "is_initial": false,
      "is_terminal": false,
      "is_error": false,
      "handler": null,
      "success_next": "pending_extract",
      "failure_next": "clean_failed",
      "is_processing": true
    },
    {
      "name": "pending_extract",
      "label": "等待提取",
      "description": "等待启动元数据提取",
      "sort_order": 5,
      "is_initial": false,
      "is_terminal": false,
      "is_error": false,
      "handler": null,
      "success_next": "extract_processing",
      "failure_next": "extract_failed"
    },
    {
      "name": "extract_processing",
      "label": "元数据提取中",
      "description": "元数据提取进行中，从清洗后的文本中提取合同关键信息",
      "sort_order": 6,
      "is_initial": false,
      "is_terminal": false,
      "is_error": false,
      "handler": null,
      "success_next": "pending_section",
      "failure_next": "extract_failed",
      "is_processing": true
    },
    {
      "name": "pending_section",
      "label": "等待章节分析",
      "description": "等待启动章节结构分析",
      "sort_order": 7,
      "is_initial": false,
      "is_terminal": false,
      "is_error": false,
      "handler": null,
      "success_next": "section_processing",
      "failure_next": "section_failed"
    },
    {
      "name": "section_processing",
      "label": "章节分析中",
      "description": "章节结构分析进行中，LLM分析文档章节结构并生成导航索引",
      "sort_order": 8,
      "is_initial": false,
      "is_terminal": false,
      "is_error": false,
      "handler": null,
      "success_next": "pending_review",
      "failure_next": "section_failed",
      "is_processing": true
    },
    {
      "name": "pending_review",
      "label": "等待确认",
      "sort_order": 9,
      "is_initial": false,
      "is_terminal": false,
      "is_error": false,
      "handler": null,
      "success_next": null,
      "failure_next": null
    },
    {
      "name": "confirmed",
      "label": "已确认",
      "sort_order": 10,
      "is_initial": false,
      "is_terminal": true,
      "is_error": false,
      "handler": null,
      "success_next": null,
      "failure_next": null
    },
    {
      "name": "ocr_failed",
      "label": "OCR失败",
      "sort_order": 99,
      "is_initial": false,
      "is_terminal": false,
      "is_error": true,
      "handler": null,
      "success_next": null,
      "failure_next": null
    },
    {
      "name": "clean_failed",
      "label": "清洗失败",
      "sort_order": 99,
      "is_initial": false,
      "is_terminal": false,
      "is_error": true,
      "handler": null,
      "success_next": null,
      "failure_next": null
    },
    {
      "name": "extract_failed",
      "label": "提取失败",
      "sort_order": 99,
      "is_initial": false,
      "is_terminal": false,
      "is_error": true,
      "handler": null,
      "success_next": null,
      "failure_next": null
    },
    {
      "name": "section_failed",
      "label": "章节分析失败",
      "sort_order": 99,
      "is_initial": false,
      "is_terminal": false,
      "is_error": true,
      "handler": null,
      "success_next": null,
      "failure_next": null
    }
  ],
  "runtime": {
    "frontend": {
      "entry": "frontend/views/AppRuntimeView.vue"
    },
    "tick": "tick/index.js"
  },
  "apis": [
    {
      "path": "/records",
      "methods": [
        "GET"
      ],
      "handler": "server/controllers/records.js"
    },
    {
      "path": "/records/:recordId",
      "methods": [
        "GET"
      ],
      "handler": "server/controllers/records.js"
    },
    {
      "path": "/status-summary",
      "methods": [
        "GET"
      ],
      "handler": "server/controllers/records.js"
    },
    {
      "path": "/records/:recordId/confirm",
      "methods": [
        "POST"
      ],
      "handler": "server/controllers/records.js"
    },
    {
      "path": "/records/:recordId/retry",
      "methods": [
        "POST"
      ],
      "handler": "server/controllers/records.js"
    }
  ],
  "visibility": "all"
}
